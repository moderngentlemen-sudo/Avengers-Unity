<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    Browser playtest: compiles the real deterministic simulation (Assets/_Project/Scripts/Sim) to
    WebAssembly and exposes a tiny API to the JavaScript renderer in wwwroot. No Unity involved.
    dotnet publish -c Release  ->  bin/Release/net8.0/publish/wwwroot
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CompressionEnabled>false</CompressionEnabled>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Scripts/Sim/**/*.cs" />
    <Compile Include="WebGame.cs" />
  </ItemGroup>
</Project>
